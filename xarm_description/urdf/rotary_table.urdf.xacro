<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro" name="rotary_table">

    <!-- ‣‣‣ NEW parameters for the rotary table -->
  <xacro:property name="rot_base_radius" value="0.20"/>
  <xacro:property name="rot_base_height" value="0.18"/>
  <xacro:property name="rot_plate_radius" value="0.20"/>
  <xacro:property name="rot_plate_height" value="0.188"/>
  <xacro:property name="rot_origin_xyz" value="0.4915 -0.238 0"/>  <!-- position in world -->




  <link name="rotary_table_base">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://xarm_moveit_config/meshes/rotary_stand_centered.STL" />
      </geometry>
      <material name="RotaryGrey">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://xarm_moveit_config/meshes/rotary_stand_centered.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- fixed transform world → rotary_table_base -->
  <joint name="world_to_rotary_base" type="fixed">
    <parent link="world"/>
    <child  link="rotary_table_base"/>
    <origin xyz="${rot_origin_xyz}" rpy="0 0 0"/>
  </joint>

  <!-- rotating plate -->
  <link name="rotary_table_plate">
    <visual>
      <origin xyz="0 0 -0.008" rpy="1.5708 0 0"/>
      <geometry>
        <!-- <cylinder radius="${rot_plate_radius}" length="${rot_plate_height}"/> -->
        <mesh filename="package://xarm_moveit_config/meshes/RotaryPlate_centered.STL" />
      </geometry>
      <material name="RotaryBlue">
        <color rgba="0.2 0.4 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.008" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://xarm_moveit_config/meshes/RotaryPlate_centered.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.008" rpy="1.5708 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.02" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="rotary_table_joint" type="revolute">
    <parent link="rotary_table_base"/>
    <child  link="rotary_table_plate"/>
    <origin xyz="0 0 ${rot_base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="20" velocity="1.5"/>
  </joint>



  <!-- ros2_control specification for the rotary joint (fake hardware) -->
  <ros2_control name="RotaryTableHW" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>

      <!-- Plain space-separated style (simplest) -->
      <param name="joints">rotary_table_joint</param>
      <param name="command_interfaces">position</param>
      <param name="state_interfaces">position</param>
      <param name="fake_sensor_commands">true</param>
    </hardware>

    <joint name="rotary_table_joint">
      <state_interface   name="position"/>
      <command_interface name="position"/>
    </joint>
  </ros2_control>
</robot>



